# Configurações do Banco de Dados PostgreSQL
DATABASE_URL=postgres://jungle_user:jungle_password@127.0.0.1:5432/jungle_db?sslmode=disable

# Configurações AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-transactions.fifo

# Configurações do IdP Keycloak (OAuth2 / OIDC)
KEYCLOAK_URL=http://127.0.0.1:8080/realms/jungle-realm

# Servidor HTTP
PORT=8081
GIN_MODE=release
